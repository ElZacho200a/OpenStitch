* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.dst binary
*.pdf binary
*.osp binary
# SVG : traité comme texte mais fins de ligne LF pour un rendu stable
*.svg text eol=lf
*.sh text eol=lf
# Correctifs vcpkg conservés pour la CI : octets exacts (SHA512 vérifiés par seed.sh puis vcpkg)
.github/vcpkg-downloads/*.patch -text
.github/vcpkg-downloads/*.diff -text
.github/vcpkg-downloads/SHA512SUMS text eol=lf
.github/vcpkg-downloads/PREFETCH text eol=lf
