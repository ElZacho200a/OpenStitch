{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio le plus récent, x64)",
      "binaryDir": "${sourceDir}/build/msvc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "OPENSTITCH_BUILD_LEGACY_V1": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo (optimisation modérée + symboles)",
      "binaryDir": "${sourceDir}/build/msvc-relwithdebinfo",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "OPENSTITCH_BUILD_LEGACY_V1": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-sccache",
      "displayName": "MSVC + Ninja + sccache (POC optionnel, voir docs/source/build-sccache.md)",
      "description": "Lancer depuis un shell developpeur x64 (scripts/dev/sccache-env.ps1). Generateur Ninja Multi-Config : seul un generateur Makefile/Ninja honore CMAKE_CXX_COMPILER_LAUNCHER.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/msvc-sccache",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "OPENSTITCH_BUILD_LEGACY_V1": "ON",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },    {
      "name": "linux-core",
      "displayName": "Linux (coeur + CLI uniquement, sans Qt)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-core",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "OPENSTITCH_BUILD_DESKTOP": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-sccache-debug", "configurePreset": "msvc-sccache", "configuration": "Debug" },
    { "name": "msvc-sccache-release", "configurePreset": "msvc-sccache", "configuration": "Release" },
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-release-relwithdebinfo", "configurePreset": "msvc-relwithdebinfo", "configuration": "RelWithDebInfo" },
    { "name": "linux-core", "configurePreset": "linux-core" }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": { "outputOnFailure": true }
    }
  ]
}
