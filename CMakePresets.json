{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio le plus récent, x64)",
      "binaryDir": "${sourceDir}/build/msvc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "OPENSTITCH_BUILD_LEGACY_V1": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo (optimisation modérée + symboles)",
      "binaryDir": "${sourceDir}/build/msvc-relwithdebinfo",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "OPENSTITCH_BUILD_LEGACY_V1": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "OPENSTITCH_BUILD_LEGACY_V1": "OFF",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Dev Ninja Debug (Studio, sans Widgets V1, tests actifs)",
      "inherits": "dev-base",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "dev-relwithdebinfo",
      "displayName": "Dev Ninja RelWithDebInfo (Studio, sans Widgets V1, tests actifs)",
      "inherits": "dev-base",
      "binaryDir": "${sourceDir}/build/dev-relwithdebinfo",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "dev-notests",
      "displayName": "Dev Ninja Debug sans tests (Studio seul, configuration et lien plus rapides)",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/dev-notests",
      "cacheVariables": { "OPENSTITCH_BUILD_TESTS": "OFF" }
    },
    {
      "name": "linux-core",
      "displayName": "Linux (coeur + CLI uniquement, sans Qt)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-core",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "OPENSTITCH_BUILD_DESKTOP": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-release-relwithdebinfo", "configurePreset": "msvc-relwithdebinfo", "configuration": "RelWithDebInfo" },
    { "name": "dev-debug", "configurePreset": "dev-debug", "targets": ["openstitch_v2_studio"] },
    { "name": "dev-relwithdebinfo", "configurePreset": "dev-relwithdebinfo", "targets": ["openstitch_v2_studio"] },
    { "name": "dev-notests", "configurePreset": "dev-notests", "targets": ["openstitch_v2_studio"] },
    { "name": "linux-core", "configurePreset": "linux-core" }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": { "outputOnFailure": true }
    }
  ]
}
